# AgentScheduler — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Opencode server connection
OPENCODE_HOST=127.0.0.1
OPENCODE_PORT=4096

# Optional HTTP Basic Auth (set OPENCODE_SERVER_PASSWORD when starting opencode serve)
# OPENCODE_PASSWORD=
# OPENCODE_USERNAME=opencode

# Optional scheduler model defaults
# OPENCODE_TASK_MODEL=zen/minimax2.5-free
# COPILOT_MODEL=gpt-5.3-codex
# CLAUDE_TASK_MODEL=sonnet
# CODEX_TASK_MODEL=gpt-5.3-codex
# PI_AGENT_TASK_MODEL=openai/gpt-4o
