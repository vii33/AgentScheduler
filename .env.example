# AgentScheduler — Environment Variables
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed.

# Optional scheduler model defaults
# OPENCODE_TASK_MODEL=github-copilot/gpt-5.4-mini
# COPILOT_MODEL=gpt-5.3-codex
# CLAUDE_TASK_MODEL=sonnet
# CODEX_TASK_MODEL=gpt-5.3-codex
# PI_AGENT_TASK_MODEL=openai/gpt-4o

# Optional continuous-loop polling interval
# TASK_LOOP_POLL_SECONDS=300
